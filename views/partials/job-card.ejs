<article
  class="job-card"
  data-id="<%= job.id %>"
  data-department="<%= job.department || '' %>"
  data-workplace="<%= job.workplace || '' %>"
  data-type="<%= job.employmentType || '' %>"
  data-salary="<%= job.salary || '' %>"
  data-tags="<%= Array.isArray(job.tags) ? job.tags.join(',') : '' %>"
>
  <div class="job-card__main">
    <img
      class="job-card__logo"
      src="<%= basePath %>/<%= job.company.logo %>"
      alt="<%= job.company.name %> logo"
      width="52"
      height="52"
      loading="lazy"
    >
    <div class="job-card__info">
      <h3 class="job-card__title">
        <a href="<%= basePath %>/jobs/<%= job.id %>"><%= job.title %></a>
      </h3>
      <p class="job-card__meta">
        <span><%= job.company.name %></span>
        <span class="job-card__dot" aria-hidden="true">&bull;</span>
        <span><%= job.location %></span>
        <span class="job-card__dot" aria-hidden="true">&bull;</span>
        <span><%= job.employmentType %></span>
      </p>
    </div>
  </div>

  <div class="job-card__actions">
    <button
      class="job-card__save"
      type="button"
      aria-label="Save job"
      aria-pressed="false"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
      </svg>
    </button>
    <a class="job-card__apply" href="<%= basePath %>/jobs/<%= job.id %>">Apply</a>
  </div>
</article>