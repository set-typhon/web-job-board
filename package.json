{
  "name": "heuristic-startup-job-board",
  "version": "1.0.0",
  "private": true,
  "description": "Four-page responsive startup job board built with Express and EJS templates.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "sass:watch": "sass --watch src/scss/main.scss:public/css/main.css",
    "build": "sass src/scss/main.scss:public/css/main.css --style=compressed && node build.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
